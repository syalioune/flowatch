node_modules/
dist/
coverage/
# Transient GitHub Pages staging output (Makefile: landing-stage / landing-preview).
# The CI workflow rebuilds it from landing/ + branding/ on every deploy.
_site/
# Vitest browser mode emits diagnostic screenshots on failure — Story 2.4
# introduces the deliberate snapshot baseline; everything else is transient.
src/**/__screenshots__/
__screenshots__/
# Playwright E2E (Story 2.3) artefacts — reports, traces, browser cache.
e2e/test-results/
e2e/playwright-report/
e2e/.playwright-cache/
# Vitest CI JUnit report (Story 4.1) — only the GitHub Actions runner writes
# it; uploaded as an artifact on failure.
test-results/
# CodeQL local analysis output (Makefile: codeql / codeql-clean). CI runs in
# .github/workflows/codeql.yml use the runner's ephemeral DB — these paths
# only exist when contributors reproduce the scan locally.
.codeql-db/
codeql.sarif
# Transient stash dir used by `make codeql` to keep coverage/lcov-report
# noise out of the local SARIF — should never be committed.
.coverage-stash-for-codeql/
# Stryker mutation testing (Makefile: mutate / mutate-clean). CI runs in
# .github/workflows/mutate.yml upload reports/mutation/ as an artifact;
# local runs write the same paths and should never be committed.
.stryker-tmp/
reports/mutation/
# Trivy filesystem scan (.github/workflows/ci.yml) downloads its vuln DB to
# .cache/trivy/ inside the workspace; biome's ci step (which uses .gitignore
# via vcs.useIgnoreFile) would otherwise flag the unformatted metadata.json.
.cache/
.env
.env.local
.DS_Store
*.log
.venv

# BMAD artefacts live in a private companion repo (syalioune/flowatch-bmad)
# and are symlinked here by setup-dev.sh. Both the symlinks themselves and
# anything that resolves through them must stay out of the public repo.
_bmad
_bmad-output

# Claude Code per-developer overrides — settings.local.json (and any sibling
# *.local.json) are gitignored so contributors can add personal permission
# allowlists without polluting the shared .claude/settings.json.
.claude/*.local.json