meta {
  name: Add user to group
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/identity/groups/{{groupId}}/members
  body: json
  auth: basic
}

body:json {
  {
    "userId": "{{userId}}"
  }
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

vars:pre-request {
  userId: rest-admin
  groupId: managers
}

docs {
  # Add user to group

  Flowable 7.2 OSS only honours the group-centric route:
  POST /identity/groups/{groupId}/members with body { userId }.
  The inverse user-centric route (POST /identity/users/{userId}/groups)
  returns HTTP 500 on the live engine — confirmed via Bruno during 14.3
  post-closure verification.

  Related: PRD FR-30.
}
