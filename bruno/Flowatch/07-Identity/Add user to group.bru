meta {
  name: Add user to group
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/identity/groups/{{groupId}}/members
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
     "userId":"operator1"
  }
}

vars:pre-request {
  groupId: testgroup
}
