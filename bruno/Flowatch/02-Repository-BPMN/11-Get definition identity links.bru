meta {
  name: Get definition identity links
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/repository/process-definitions/{{processDefinitionId}}/identitylinks
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

vars:pre-request {
  processDefinitionId: PASTE_A_PROCESS_DEFINITION_ID
}

docs {
