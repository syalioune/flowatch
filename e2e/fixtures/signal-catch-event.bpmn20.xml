<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowatch.test/e2e">
  <signal id="cancelRequestedSignal" name="cancel-requested"/>
  <process id="signalCatchE2E" name="Signal catch E2E" isExecutable="true">
    <startEvent id="start" name="Process started"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="prepareTask"/>
    <userTask id="prepareTask" name="Prepare work" flowable:assignee="alice"/>
    <sequenceFlow id="flow2" sourceRef="prepareTask" targetRef="catchCancel"/>
    <intermediateCatchEvent id="catchCancel" name="Await cancel signal">
      <signalEventDefinition signalRef="cancelRequestedSignal"/>
    </intermediateCatchEvent>
    <sequenceFlow id="flow3" sourceRef="catchCancel" targetRef="end"/>
    <endEvent id="end" name="Cancelled"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_signalCatch">
    <bpmndi:BPMNPlane id="BPMNPlane_signalCatch" bpmnElement="signalCatchE2E">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareTask_di" bpmnElement="prepareTask">
        <omgdc:Bounds x="200" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catchCancel_di" bpmnElement="catchCancel">
        <omgdc:Bounds x="360" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="460" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <omgdi:waypoint x="136" y="118"/>
        <omgdi:waypoint x="200" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <omgdi:waypoint x="300" y="118"/>
        <omgdi:waypoint x="360" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <omgdi:waypoint x="396" y="118"/>
        <omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
