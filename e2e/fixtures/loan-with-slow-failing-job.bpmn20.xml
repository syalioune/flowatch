<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://flowatch.test/e2e"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath">

  <!--
    Fixture for live-engine testing of /jobs?type=executable (Story 12.4
    stacktrace panel on an executable-tab row).

    The async service task references a class that is not on the classpath,
    so Flowable's class-loader throws on every attempt. With the slow
    R3/PT5M retry policy:

      t=0:    instance starts; engine creates an executable job
      t=0:    first attempt fails → retries=2, exceptionMessage set;
              job STAYS in /management/jobs with lockExpirationTime = t+5m
      t=5m:   retry → fails again → retries=1, lock = t+10m
      t=10m:  retry → fails again → retries=0 → MOVES to deadletter

    Net result: the row is visible in /jobs?type=executable for ~15 minutes
    with j.exceptionMessage truthy, which is exactly the condition under
    which the `View stacktrace` row action is offered (predicate
    `!!j.exceptionMessage` from Story 12.1 AC-6).

    To exercise faster cycles use e2e/fixtures/loan-with-failing-job.bpmn20.xml
    (R1/PT1S — dead-letters in seconds).
  -->

  <process id="loanWithSlowFailingJob" name="Loan with slow-failing service task" isExecutable="true">
    <startEvent id="start" name="Application received"/>

    <sequenceFlow id="flow1" sourceRef="start" targetRef="failingService"/>

    <serviceTask id="failingService"
                 name="Always fails (class missing)"
                 flowable:async="true"
                 flowable:exclusive="true"
                 flowable:class="com.example.IntentionallyMissingService">
      <extensionElements>
        <flowable:failedJobRetryTimeCycle>R3/PT5M</flowable:failedJobRetryTimeCycle>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="flow2" sourceRef="failingService" targetRef="end"/>

    <endEvent id="end" name="Application decided"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram_loanWithSlowFailingJob">
    <bpmndi:BPMNPlane id="plane_loanWithSlowFailingJob" bpmnElement="loanWithSlowFailingJob">

      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="160" width="30" height="30"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="80" y="195" width="80" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_failingService" bpmnElement="failingService">
        <omgdc:Bounds x="200" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <omgdc:Bounds x="390" y="160" width="30" height="30"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="370" y="195" width="80" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="130" y="175"/>
        <omgdi:waypoint x="200" y="175"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="320" y="175"/>
        <omgdi:waypoint x="390" y="175"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
