meta {
  name: Historic activity instances
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/history/historic-activity-instances?processInstanceId={{instanceId}}
  body: none
  auth: basic
}

params:query {
  processInstanceId: PASTE_AN_INSTANCE_ID
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

