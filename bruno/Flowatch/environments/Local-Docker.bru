vars {
  baseUrl: http://localhost:8080/flowable-rest/service
  dmnBase: http://localhost:8080/flowable-rest/dmn-api
  cmmnBase: http://localhost:8080/flowable-rest/cmmn-api
  appBase: http://localhost:8080/flowable-rest/app-api
  username: rest-admin
  password: test
  tenantId:
}

# Local-Docker = the dev stack from docker-compose.yml. All four sub-app
# roots resolve to the nginx CORS proxy on :8080 in front of the
# `flowable` container. Use this environment when running the Flowable
# stack via `docker compose up -d` (or `bash scripts/dev/run-dev.sh`).
