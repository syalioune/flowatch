<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowatch.test/e2e">
  <process id="loanWithForm" name="Loan With Form" isExecutable="true">
    <startEvent id="start" name="Application received"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="approveTask"/>
    <userTask id="approveTask" name="Approve loan with form">
      <extensionElements>
        <flowable:formProperty id="decision" name="Decision" type="enum" required="true">
          <flowable:value id="approve" name="Approve"/>
          <flowable:value id="reject" name="Reject"/>
        </flowable:formProperty>
        <flowable:formProperty id="comment" name="Comment" type="string"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow2" sourceRef="approveTask" targetRef="end"/>
    <endEvent id="end" name="Decision made"/>
  </process>
</definitions>
