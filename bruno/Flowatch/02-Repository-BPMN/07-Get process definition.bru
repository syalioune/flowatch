meta {
  name: Get process definition
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/repository/process-definitions/{{processDefinitionId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

vars:pre-request {
  processDefinitionId: PASTE_A_PROCESS_DEFINITION_ID
}
