meta {
  name: List process instances
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/runtime/process-instances?size=10&sort=startTime&order=desc
  body: none
  auth: basic
}

params:query {
  size: 10
  sort: startTime
  order: desc
  ~tenantId: {{tenantId}}
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

docs { Related: PRD FR-15. }
