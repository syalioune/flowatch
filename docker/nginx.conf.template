# ALLOWED_ORIGIN contract
# ----------------------
# This value is interpolated verbatim into `Access-Control-Allow-Origin`.
# The CORS spec requires the value to be a single, exact origin (scheme + host
# + optional port) with NO trailing slash. Comma-separated lists and the `*`
# wildcard are NOT supported when `Access-Control-Allow-Credentials: true`
# (which we set below).
#
# Examples that work:
#   ALLOWED_ORIGIN=http://localhost:5173
#   ALLOWED_ORIGIN=https://flowatch.example.com
#
# Examples that BREAK in browsers (no nginx error — silent CORS rejection):
#   ALLOWED_ORIGIN=http://localhost:5173/        (trailing slash)
#   ALLOWED_ORIGIN=*                             (incompatible with credentials)
#   ALLOWED_ORIGIN=http://a.com,http://b.com     (comma list not allowed)
#   ALLOWED_ORIGIN=                              (empty header rejects all)
#
# Validation runs at container start via /docker-entrypoint.d/40-validate-origin.sh
# which fails loud (non-zero exit) when the value is empty or ends with `/`.
server {
    listen 8080;

    location /flowable-rest/ {
        proxy_pass http://flowable:8080/flowable-rest/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # CORS — origin is parameterized via $ALLOWED_ORIGIN (envsubst).
        add_header Access-Control-Allow-Origin "${ALLOWED_ORIGIN}" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
        add_header Access-Control-Allow-Credentials "true" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }
}
