<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowatch.test/e2e">
  <message id="paymentConfirmedMessage" name="payment-confirmed"/>
  <process id="messageCatchE2E" name="Message catch E2E" isExecutable="true">
    <startEvent id="start" name="Order received"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="firstTask"/>
    <userTask id="firstTask" name="Validate order" flowable:assignee="alice"/>
    <sequenceFlow id="flow2" sourceRef="firstTask" targetRef="catchPayment"/>
    <intermediateCatchEvent id="catchPayment" name="Await payment">
      <messageEventDefinition messageRef="paymentConfirmedMessage"/>
    </intermediateCatchEvent>
    <sequenceFlow id="flow3" sourceRef="catchPayment" targetRef="end"/>
    <endEvent id="end" name="Order fulfilled"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_messageCatch">
    <bpmndi:BPMNPlane id="BPMNPlane_messageCatch" bpmnElement="messageCatchE2E">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="firstTask_di" bpmnElement="firstTask">
        <omgdc:Bounds x="200" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catchPayment_di" bpmnElement="catchPayment">
        <omgdc:Bounds x="360" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="460" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <omgdi:waypoint x="136" y="118"/>
        <omgdi:waypoint x="200" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <omgdi:waypoint x="300" y="118"/>
        <omgdi:waypoint x="360" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <omgdi:waypoint x="396" y="118"/>
        <omgdi:waypoint x="460" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
